@article{xgen2026dualexam,
  abbr        = {Tech Report},
  bibtex_show = {true},
  title       = {Dual Exam: Controlled Evaluation of Multimodal Agents and World Models},
  author      = {{XGEN Labs}},
  journal     = {XGEN Labs Technical Report},
  year        = {2026},
  month       = {sep},
  note        = {As core contributor},
  abstract    = {A benchmark for multimodal agents and world models that interact in generated worlds. Besides a coupled evaluation of agent and world model together, two controlled tracks assess them separately: the agent track fixes the environment's response rules (1,088 items across 15 task categories), and the world-model track supplies a validated action sequence and checks whether the generated states realize the action effects while preserving what must stay unchanged (400 cases across eight scenarios). Tasks span physical, digital, social and scientific domains, and success is judged against task requirements and execution evidence rather than a model's own claim of completion.},
  html        = {https://x.com/XGEN_labs/article/2103137462008844442},
  preview     = {dualexam.jpg},
  selected    = {true}
}

@inproceedings{chen2026foveaui,
  abbr              = {ACM MM},
  bibtex_show       = {true},
  title             = {FoveaUI: Foveated On-demand Visual Evidence Acquisition for GUI Grounding},
  author            = {Chen, Jingfan and Wang, Lin and Li, Qing},
  booktitle         = {Proceedings of the 34th ACM International Conference on Multimedia},
  year              = {2026},
  abstract          = {GUI grounding requires precise identification of interface elements from high-resolution screenshots, but processing dense visual inputs with large vision-language models incurs substantial computational overhead. Existing visual token compression methods typically allocate a fixed budget, ignoring the large variability of visual redundancy across different GUI layouts. We show that a fixed visual budget is suboptimal, as the necessity of high-resolution visual evidence varies substantially across interface contexts. We propose FoveaUI, a dynamic high-resolution budget allocation framework for GUI grounding. The agent first reasons over a low-resolution global view and selectively requests high-resolution crops only when fine-grained evidence is required. FoveaUI introduces three coordinated components that progressively address when to seek high-resolution detail, where to acquire it, and how to leverage it effectively: a balanced training strategy for on-demand resolution allocation, a mix-tool strategy paired with a smooth process-level reward for region and granularity selection, and locality-prioritized attention masking for efficient utilization of acquired high-resolution information. Experiments on GUI grounding benchmarks show that our method maintains strong grounding performance while substantially reducing high-resolution visual token costs.},
  preview           = {foveaui.jpg},
  selected          = {true}
}

@inproceedings{chen2026warmup,
  abbr              = {EMNLP},
  bibtex_show       = {true},
  title             = {Warm Up with a Rubric, Then Merge: Decoupling Grounding Gains from Reasoning Costs in Vision-Language Models},
  author            = {Chen, Jingfan and Wang, Lin and Su, Jingran and Li†, Qing},
  booktitle         = {Proceedings of the 2026 Conference on Empirical Methods in Natural Language Processing},
  year              = {2026},
  abstract          = {Process supervision improves perceptual grounding in RLVR-trained vision-language models, but it also incurs repeated verifier queries and reshapes the policy by suppressing exploratory entropy. We show that its benefit and cost are empirically separable: grounding gains emerge early, whereas the exploration cost accumulates with continued supervision, holding the policy's entropy below that of outcome-only RLVR. This hidden behavioral cost shows up as skill tradeoffs on static benchmarks and, more importantly, as a degraded initialization for subsequent outcome-only RLVR that prematurely limits its reachable ceiling. Motivated by this asymmetry, we propose warmup-and-merge: early-stop the process-supervised warmup, merge only a low-rank component of the warmup task vector into the base model, and continue with outcome-only RLVR under an adaptive on-policy reward that targets the model's current perceptual failures. Across multiple benchmarks and backbones, our method improves perception while preserving exploration, achieving stronger final performance at a fraction of the verifier cost of continuous process supervision.},
  annotation        = {† Corresponding author},
  preview           = {warmup_merge.jpg},
  selected          = {true}
}

